: «albatta».","jp":"ぜひ来てください。","kana":"ぜひきてください。","exampleRu":"Обязательно приходите.","exampleUz":"Albatta keling.","id":"g089","lessonId":18,"sourcePdfPages":[134,135],"exampleOrigin":"authored","romaji":"zehikitekudasai。"}]}