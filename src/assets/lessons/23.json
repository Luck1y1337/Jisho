ePdfPages":[161],"sourceOriginal":"図書館前","reviewStatus":"curated","romaji":"toshokanmae"}],"grammar":[{"title":"とき","ru":"«Когда»: обычная форма глагола + とき; い + とき; な + とき; Nのとき.","uz":"«…paytida»: fe’lning oddiy shakli + とき; い + とき; な + とき; Nのとき.","jp":"暇なとき、本を読みます。","kana":"ひまなとき、ほんをよみます。","exampleRu":"Когда свободен, читаю книги.","exampleUz":"Bo‘sh paytimda kitob o‘qiyman.","id":"g108","lessonId":23,"sourcePdfPages":[164,165],"exampleOrigin":"authored","romaji":"himanatoki、hon'oyomimasu。"},{"title":"辞書形／た + とき","ru":"Словарная форма — действие ещё не завершено в момент основного действия; た — уже завершено.","uz":"Lug‘at shakli asosiy ish paytida avvalgi ish hali tugamaganini, た esa tugaganini bildiradi.","jp":"家へ帰ったとき、電話しました。","kana":"うちへかえったとき、でんわしました。","exampleRu":"Позвонил, когда уже вернулся домой.","exampleUz":"Uyga qaytganimda telefon qildim.","id":"g109","lessonId":23,"sourcePdfPages":[164,165],"exampleOrigin":"authored","romaji":"uchiekaettatoki、denwashimashita。"},{"title":"Условие と","ru":"Словарная форма + と обозначает закономерный результат, работу устройства или маршрут. Обычно не используют для просьб и намерений в результате.","uz":"Lug‘at shakli + と tabiiy natija, qurilma ishlashi yoki yo‘lni bildiradi. Natijada odatda iltimos va niyat kelmaydi.","jp":"ここを押すと、水が出ます。","kana":"ここをおすと、みずがでます。","exampleRu":"Если нажать здесь, польётся вода.","exampleUz":"Shu yerni bossangiz, suv chiqadi.","id":"g110","lessonId":23,"sourcePdfPages":[164,165],"exampleOrigin":"authored","romaji":"kokooosuto、mizugademasu。"},{"title":"が; путь を","ru":"が отмечает наблюдаемое состояние или действие. を после места может обозначать путь движения.","uz":"が kuzatilayotgan holat yoki harakatni bildiradi. Joydan keyin を harakat yo‘lini ko‘rsatishi mumkin.","jp":"橋を渡ります。","kana":"はしをわたります。","exampleRu":"Перехожу мост.","exampleUz":"Ko‘prikdan o‘taman.","id":"g111","lessonId":23,"sourcePdfPages":[164,165],"exampleOrigin":"authored","romaji":"hashiowatarimasu。"}]}